import java.util.ArrayList;
import java.util.List;

import java_cup.runtime.*;
import chocopy.common.astnodes.*;

/* The following code section is copied verbatim to the generated
 * parser class. */
parser code {:

    /* The following fields and methods deal with error reporting
     * Avoid changing these unless you know what you are doing. */

    /** Node that accumulates error messages to be added to the Program
     *  node produced as a result. */
    public final Errors errors = new Errors(new ArrayList<>());

    /** Return the Program node that results from parsing the stream of
     *  tokens produced by lexical analysis.  In the case of syntax errors,
     *  the program may be empty, but will have error messages. */
    public Program parseProgram(boolean debug) {
        try {
            Symbol result = debug ? debug_parse() : parse();
            if (result == null || !(result.value instanceof Program)) {
                return new Program(new Location(0, 0), new Location(0, 0),
                                   new ArrayList<Declaration>(),
                                   new ArrayList<Stmt>(),
                                   errors);
            } else {
                return (Program) result.value;
            }
        } catch (RuntimeException excp) {
            throw excp;
        } catch (Exception excp) {
            String msg =
                String.format("Internal parser error detected: %s%n", excp);
            throw new AssertionError(msg);
        }
    }

    @Override
    public SymbolFactory getSymbolFactory() {
        return ((ChocoPyLexer) getScanner()).symbolFactory;
    }

    @Override
    public void syntax_error(Symbol cur_token) {
                String token = symbl_name_from_id(cur_token.sym);
                String text = ((ChocoPyLexer) getScanner()).yytext();
                errors.syntaxError(
                    ((ComplexSymbolFactory.ComplexSymbol) cur_token).xleft,
                    ((ComplexSymbolFactory.ComplexSymbol) cur_token).xright,
                    "Parse error near token %s: %s", token, text);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) {
        /* Do not die */
    }
:}


/**************************************************************************
 *              FEEL FREE TO MODIFY ANYTHING BELOW THIS LINE              
 *
 * The rules provided below parse expressions of the form <INT> + <INT> + ... 
 * You can re-use these rules or edit them as you wish. The start rule
 * should return a node of type Program.
 *
 * Tips: Production rules are usually followed by action code that will be
 * copied to the generated parser to be executed immediately after a reduce
 * operation; that is, when a production rule has been matched. You can name
 * a nonterminal or terminal symbol in a production rule using the colon
 * notation, e.g. expr_stmt ::= expr:e, to get the AST node for the matched
 * expression. In the action code, `e` will be a variable of whatever type
 * has been declared for the corresponding nonterminal, such as `Expr`.
 * Therefore, you can construct an AST Node of type `ExprStmt` with `e` in the
 * constructor: `new ExprStmt(exleft, exright, e)`
 *
 * The variables `exleft` and `exright` are automatically generated by CUP
 * and contain Location objects for the start and end of the expression `e`.
 * You can collect start and line number info for AST nodes by taking the
 * location of the left end of the leftmost symbol in a rule and the
 * location of the right end of the rightmost symbol. The auto-generated
 * variables have names `<sym>xleft` and `<sym>xright`, where <sym> is the
 * name given to the symbol using the colon notation.
 *
 * When you have nonterminals that are lists of things, e.g. List<Stmt> or
 * List<Declaration>, it is helpful to get the leftmost and rightmost
 * source location from within this list; we have provided some utility
 * functions below to do just that.
 **************************************************************************/


/* The following code section is copied verbatim to the class that performs
 * production-rule actions. */
action code {:

    /** Return a mutable list initially containing the single value ITEM. */
    <T> List<T> single(T item) {
        List<T> list = new ArrayList<>();
        if (item != null) {
            list.add(item);
        }
        return list;
    }

    /** If ITEM is non-null, appends it to the end of LIST.  Then returns
     *  LIST. */
    <T> List<T> combine(List<T> list, T item) {
        if (item != null) {
            list.add(item);
        }
        return list;
    }

    /** Return a mutable empty list. */
    <T> List<T> empty() {
        return new ArrayList<T>();
    }

    /** Return the leftmost non-whitespace location in NODES, or null if NODES
     *  is empty.  Assumes that the nodes of NODES are ordered in increasing
     *  order of location, from left to right. */
    ComplexSymbolFactory.Location getLeft(List<? extends Node> nodes) {
        if (nodes.isEmpty()) {
            return null;
        }
        Node first = nodes.get(0);
        return new ComplexSymbolFactory.Location(first.getLocation()[0],
                                                 first.getLocation()[1]);
    }

    /* funcao para pegar o elemento mais a direita da lista */
    ComplexSymbolFactory.Location getRight(List<? extends Node> nodes){
        if (nodes.isEmpty()){
            return null;
        }
        Node last = nodes.get(nodes.size()-1);
        return new ComplexSymbolFactory.Location(last.getLocation()[2],
                                                 last.getLocation()[3]);
    }

:}

/* Terminal symbols (tokens returned by the lexer).  The declaration
 *     terminal <identifier1>, <identifier2>, ...;
 * declares each <identifieri> as the denotation of a distinct type terminal
 * symbol for use in the grammar.  The declaration
 *     terminal <type> <identifier1>, ...;
 * does the same, and in addition indicates that the lexer supplies a
 * semantic value of type <type> for these symbols that may be referenced
 * in actions ( {: ... :} ).
 */


/* Line Structure Tokens*/
terminal NEWLINE;
terminal INDENT;
terminal DEDENT;
// terminal comment removido (nao deve ser emitido)

/* Returned by the lexer for erroneous tokens.  Since it does not appear in
 * the grammar, it indicates a syntax error. */
terminal UNRECOGNIZED;
terminal BAD_INDENTATION; // todo

/* Identifier */
terminal String IDSTRING; // strings de identifiers
 

/* Literals */
/* boolean literals True and False are simply represented by their keyword tokens */
terminal String STRING; // strings entre aspas duplas (literais)
terminal Integer NUMBER;  // Integer Literal

/* Operators */
/* as stated on the language reference document, the operator tokens are the following: + - * // % < > <= >= 
 == != = ( ) [ ] , : . -> */

terminal String PLUS;
terminal String MINUS;
terminal String TIMES;
terminal String DIVISION;
terminal String MOD;
terminal String LESS_THAN;
terminal String GREATER_THAN;
terminal String LESS_THAN_EQUAL_TO;
terminal String GREATER_THAN_EQUAL_TO;
terminal String EQUAL_TO;
terminal String NOT_EQUAL_TO;
terminal String EQUAL;
terminal String LEFT_PARENTHESIS;
terminal String RIGHT_PARENTHESIS;
terminal String LEFT_BRACKET;
terminal String RIGHT_BRACKET;
terminal String COMMA;
terminal String COLON;
terminal String RIGHT_ARROW;
terminal String UNARYMINUS;
terminal String DOT;


/* KEYWORDS */
/* as stated on the language reference document, the keyword tokens are the following: False, None, True, and, as,
assert, async, await, break, class, continue, def, del, elif, else, except, finally, for, from, global, if, import,
in, is, lambda, nonlocal, not, or, pass, raise, return, try, while, with, yield. */

terminal Boolean BOOL; // engloba True e False
terminal NONE;
terminal AND;
terminal CLASS;
terminal DEF;
terminal ELIF; 
terminal ELSE; 
terminal FOR;
terminal GLOBAL; 
terminal IF; 
terminal IN; 
terminal IS;
terminal NONLOCAL; 
terminal NOT; 
terminal OR; 
terminal PASS; 
terminal RETURN; 
terminal WHILE;

/* foi necessario retirar os terminais a seguir devido a warnings de declared but never used */


/*terminal EXCEPT;
 *terminal WITH;
 *terminal YIELD;
 *terminal CONTINUE;
 *terminal ASSERT;
 *terminal LAMBDA;
 *terminal TRY;
 *terminal BREAK;
 *terminal FINALLY;
 *terminal FROM;
 *terminal IMPORT;
 *terminal AWAIT;
 *terminal DEL;
 *terminal ASYNC;
 *terminal AS;
 *terminal RAISE; */

/* TODO: DELIMITER TOKENS */


/* Nonterminal symbols (defined in production rules below).
 * As for terminal symbols, 
 *     non terminal <type> <identifier1>, ..., <identifiern>; 
 * defines the listed nonterminal identifier symbols to have semantic values
 * of type <type>. */
non terminal Program           program;
non terminal List<Declaration> program_head, func_body, class_body;
non terminal List<Stmt>        stmt_list, opt_stmt_list, block, elif_body, else_body;
non terminal Stmt              stmt, expr_stmt, assignment_expr;
non terminal Expr              expr, binary_expr, call_expr, methodcall_expr, target;
non terminal IndexExpr         index_expr;
non terminal MemberExpr        member_expr;
non terminal List<Expr>        list_expr, list_targets;
non terminal ClassDef          class_def;
non terminal FuncDef           func_def;
non terminal TypeAnnotation    type;
non terminal TypedVar          typed_var;
non terminal List<TypedVar>    typedvar_list;
non terminal Identifier        identifier;
non terminal Literal           literal;
non terminal Declaration       global_decl, nonlocal_decl;
non terminal VarDef            var_def;

/* Precedences (lowest to highest) for resolving what would otherwise be
 * ambiguities in the form of shift/reduce conflicts.. */
/* segundo a secao 4.1 do chocopy language reference*/

precedence right IF, ELSE;
precedence left OR;
precedence left AND;
precedence nonassoc EQUAL_TO, NOT_EQUAL_TO, LESS_THAN, GREATER_THAN, LESS_THAN_EQUAL_TO, GREATER_THAN_EQUAL_TO, IS;
precedence left PLUS, MINUS;
precedence left TIMES, DIVISION, MOD;
precedence left UNARYMINUS;
precedence left DOT, COMMA, LEFT_BRACKET, RIGHT_BRACKET;

/* The start symbol. */
start with program;


/*****  GRAMMAR RULES *****/
/* regras especificadas segundo os capitulos 2 e 4 do chocopy language reference */
/* objetivo: atender os kinds de nós da AST (classes no common/astnodes) dentro das regras do chocopy */

program ::= program_head:d opt_stmt_list:s
        {: RESULT = new Program(d.isEmpty() ? getLeft(s) : getLeft(d),
                                sxright, d, s, errors);
        :}
        ;

/* Initial list of declarations. */
program_head ::=                               {: RESULT = empty(); :}
               | program_head:ph var_def:vd    {: RESULT = combine(ph, vd); :}
               | program_head:ph func_def:fd   {: RESULT = combine(ph, fd); :}
               | program_head:ph class_def:cd  {: RESULT = combine(ph, cd); :}
               ;

// convertendo string de Identifier para o simbolo nao terminal (constroi um identifier)
identifier ::= IDSTRING:id  {: RESULT = new Identifier(idxleft, idxright, id); :} 
             ;

class_def ::= CLASS:cl identifier:id1 LEFT_PARENTHESIS identifier:id2 RIGHT_PARENTHESIS COLON NEWLINE INDENT class_body:cb DEDENT
                {: RESULT = new ClassDef(clxleft, getRight(cb), id1, id2, cb); :}
            ;

/* todo: verificar o que fazer quanto ao pass newline */
class_body ::= class_body:cb var_def:vd   {: RESULT = combine(cb, vd); :}
             | class_body:cb func_def:fd  {: RESULT = combine(cb, fd); :}
             | var_def:vd                 {: RESULT = single(vd); :}
             | func_def:fd                {: RESULT = single(fd); :}
             ;

/* retiramos definicao sem tipo, muitos problemas */
func_def ::= DEF:def identifier:id LEFT_PARENTHESIS typedvar_list:tvl RIGHT_PARENTHESIS RIGHT_ARROW type:ty COLON NEWLINE INDENT func_body:fb stmt_list:stl DEDENT
            {: RESULT = new FuncDef(defxleft, getRight(stl), id, tvl, ty, fb, stl); :}
            /*
            *| DEF:def identifier:id LEFT_PARENTHESIS typedvar_list:tvl RIGHT_PARENTHESIS COLON NEWLINE INDENT func_body:fb stmt_list:stl DEDENT
            *{: RESULT = new FuncDef(defxleft, getRight(stl), id, tvl, None, fb, stl); :}*/
           ;

func_body ::=                                {: RESULT = empty(); :}
            | func_body:fb global_decl:gd    {: RESULT = combine(fb, gd); :}
            | func_body:fb nonlocal_decl:nd  {: RESULT = combine(fb, nd); :}
            | func_body:fb var_def:vd        {: RESULT = combine(fb, vd); :}
            | func_body:fb func_def:fd       {: RESULT = combine(fb, fd); :}
            ;

typed_var ::= identifier:id COLON type:ty {: RESULT = new TypedVar(idxleft, tyxright, id, ty); :}
            ;

typedvar_list ::=                                       {: RESULT = empty(); :}
                | typed_var:tv                          {: RESULT = single(tv); :}
                | typedvar_list:tvl COMMA typed_var:tv  {: RESULT = combine(tvl, tv); :}
                ;

type ::= identifier:id                             {: RESULT = new ClassType(idxleft, idxright, id.name); :}
       | STRING:s                                  {: RESULT = new ClassType(sxleft, sxright, s); :}
       | LEFT_BRACKET:lb type:ty RIGHT_BRACKET:rb  {: RESULT = new ListType(lbxleft, rbxright, ty); :}
       ;

global_decl ::= GLOBAL:glo identifier:id NEWLINE  {: RESULT = new GlobalDecl(gloxleft, idxright, id); :}
              ;

nonlocal_decl ::= NONLOCAL:nl identifier:id NEWLINE  {: RESULT = new NonLocalDecl(nlxleft, idxright, id); :}
                ;

var_def ::= typed_var:tv EQUAL literal:li NEWLINE  {: RESULT = new VarDef(tvxleft, lixright, tv, li); :}
          ;

/* ********************************************************************************************************** */ 
/* regras para statements */

opt_stmt_list ::=                    {: RESULT = empty(); :}
                | stmt_list:s        {: RESULT = s; :}
                ;

stmt_list ::= stmt:s                 {: RESULT = single(s); :}
            | stmt_list:l stmt:s     {: RESULT = combine(l, s); :}
            | stmt_list:l error      {: RESULT = l; :}
            /* If there is a syntax error in the source, this says to discard
             * symbols from the parsing stack and perform reductions until
             * there is a stmt_list on top of the stack, and then to discard
             * input symbols until it is possible to shift again, reporting
             * a syntax error. */
            ;

stmt ::= expr_stmt:s NEWLINE                            {: RESULT = s; :}
       | IF:i expr:e COLON block:b                      {: RESULT = new IfStmt(ixleft, getRight(b), e, b, empty()); :}
       | IF:i expr:e COLON block:b elif_body:eb         {: RESULT = new IfStmt(ixleft, getRight(eb), e, b, eb); :}
       | WHILE:wh expr:e COLON block:b                  {: RESULT = new WhileStmt(whxleft, getRight(b), e, b); :}
       | FOR:fo identifier:id IN expr:e COLON block:b   {: RESULT = new ForStmt(foxleft, getRight(b), id, e, b); :}
       ;

/* corpos do elif e do else para cobrir os casos especificados em stmt no cap 4 do lang ref */
/* elif pode ser uma lista de um ou mais statements e tambem pode nao existir (esse ultimo caso foi tratado nas regras de stmt) */
elif_body ::= ELIF:elif expr:e COLON block:b               {: RESULT = single(new IfStmt(elifxleft, getRight(b), e, b, empty())); :}
            | ELIF:elif expr:e COLON block:b elif_body:eb  {: RESULT = single(new IfStmt(elifxleft, getRight(eb), e, b, eb)); :}
            | else_body: elb                               {: RESULT = elb; :}                                            
            ;

else_body ::= ELSE COLON block:b  {: RESULT = b; :}
            ;

// verificar o que fazer quanto ao PASS
expr_stmt ::= RETURN:re expr:e    {: RESULT = new ReturnStmt(rexleft, exright, e); :}
            | assignment_expr:ae  {: RESULT = ae; :}
            ;

/* ********************************************************************************************************** */ 
/* regras para expressions */
/* nao aparecem nas astnodes: concatenation expressions e access expressions */

/* definicao de bloco, equivale a lista de statements interna */
block ::= NEWLINE INDENT stmt_list:stl DEDENT              {: RESULT = stl; :}
        ;

/* None value para returns opcionais */
literal ::= NUMBER:n                                       {: RESULT = new IntegerLiteral(nxleft, nxright, n); :}
          | STRING:s                                       {: RESULT = new StringLiteral(sxleft, sxright, s); :}
          | BOOL:b                                      {: RESULT = new BooleanLiteral(bxleft, bxright, b); :}
          | NONE:no                                        {: RESULT = new NoneLiteral(noxleft, noxright); :}          
          ;

/* expressoes unarias e listas de expressoes ja inseridos aqui diretamente */
expr ::= target:ta                                      {: RESULT = ta; :}
       | literal:lit                                    {: RESULT = lit; :}
       | binary_expr:be                                 {: RESULT = be; :}
       | MINUS:op expr:e                                {: RESULT = new UnaryExpr(opxleft, exright, op, e); :} %prec UNARYMINUS 
       | NOT:no expr:e                                  {: RESULT = new UnaryExpr(noxleft, exright, "not", e); :}
       | LEFT_BRACKET:lb list_expr:le RIGHT_BRACKET:rb  {: RESULT = new ListExpr(lbxleft, rbxright, le); :}
       | call_expr:ce                                   {: RESULT = ce; :}
       | methodcall_expr:mce                            {: RESULT = mce; :}
       | LEFT_PARENTHESIS expr:e RIGHT_PARENTHESIS      {: RESULT = e; :}
       | expr:e1 IF expr:e2 ELSE expr:e3                {: RESULT = new IfExpr(e1xleft, e3xright, e2, e1, e3); :}
       ;


/* a[b] */
index_expr ::= expr:e1 LEFT_BRACKET expr:e2 RIGHT_BRACKET:rb {: RESULT = new IndexExpr(e1xleft, rbxright, e1, e2); :}
             ;

/* a.b */
member_expr ::= expr:e DOT identifier:id {: RESULT = new MemberExpr(exleft, idxright, e, id); :}
              ;


/* componente da lista de expressoes */
list_expr ::= expr: e                   {: RESULT = single(e); :}
            | list_expr:le COMMA expr:e {: RESULT = combine(le, e); :}
            |                           {: RESULT = empty(); :}
            ;

/* para as expressoes de atribuicao */
list_targets ::= target: ta                     {: RESULT = single(ta); :}
            | list_targets:lt EQUAL target:ta   {: RESULT = combine(lt, ta); :}
            ;

target ::= identifier:id                                  {: RESULT = id; :}
         | index_expr:ie                                  {: RESULT = ie; :}
         | member_expr:me                                 {: RESULT = me; :}
         ;

assignment_expr ::= list_targets:lt EQUAL expr:e  {: RESULT = new AssignStmt(getLeft(lt), exright, lt, e); :}
                  ;

/* expressoes de chamada de funcao */
call_expr ::= identifier:id LEFT_PARENTHESIS list_expr:le RIGHT_PARENTHESIS:rp  {: RESULT = new CallExpr(idxleft, rpxright, id, le); :}
            ;

/* expressoes de chamada de metodo */
methodcall_expr ::= member_expr:me LEFT_PARENTHESIS list_expr:le RIGHT_PARENTHESIS:rp  {: RESULT = new MethodCallExpr(mexleft, rpxright, me, le); :}
                  ;

/* A binary expression, illustrating how to find the left and right
 * source position of a phrase. */
/* expressoes (binarias) aritmeticas, relacionais e logicas */
binary_expr ::= expr:e1 PLUS:op expr:e2                   {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 MINUS:op expr:e2                  {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 TIMES:op expr:e2                  {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 DIVISION:op expr:e2               {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 EQUAL_TO:op expr:e2               {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 NOT_EQUAL_TO:op expr:e2           {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 LESS_THAN:op expr:e2              {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 GREATER_THAN:op expr:e2           {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 LESS_THAN_EQUAL_TO:op expr:e2     {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 GREATER_THAN_EQUAL_TO:op expr:e2  {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 MOD:op expr:e2                    {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, op, e2); :}
              | expr:e1 IS:op expr:e2                     {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, "is", e2); :}
              | expr:e1 OR:op expr:e2                     {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, "or", e2); :}
              | expr:e1 AND:op expr:e2                    {: RESULT = new BinaryExpr(e1xleft, e2xright, e1, "and", e2); :}
              ;

/* ********************************************************************************************************** */ 